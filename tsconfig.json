{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "types": ["node", "vitest/globals"]
  },
  "include": ["apps/web", "packages", "tests", "vitest.config.ts"]
}
